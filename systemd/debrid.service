[Unit]
Description=Debrid Uploader Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=debrid
Group=debrid
WorkingDirectory=/opt/debrid
Environment=NODE_ENV=production
EnvironmentFile=/opt/debrid/.env
ExecStart=/usr/local/bin/bun run src/index.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
