PORT=3100
# In-flight jobs per host. Each one holds a TorBox slot and a proxy stream.
MAX_CONCURRENT_JOBS=4
# Jobs one account may hold at once, queued and active together. Over it, a
# submission is refused 429 rather than queued.
MAX_JOBS_PER_USER=1
# Accounts MAX_JOBS_PER_USER does not apply to, as resolved owner ids rather
# than API keys — `rd:<id>`, `tb:<id>`, `ad:<username>`. Every provider on a job
# is checked, so any one of the operator's accounts exempts it. Ids are not
# secrets; keys would be, and a TorBox key is rotated on every abuse warning.
# Get them from /user (RD), /user/me (TorBox) and /v4/user (AllDebrid).
UNLIMITED_OWNERS=
BASE_URL=http://YOUR_IP:3100
TORBOX_EMAIL=your_torbox_email
TORBOX_PASSWORD=your_torbox_password
# HTTP proxy for TorBox *downloads* only (CDN + WebDAV ranges), so TorBox sees
# the proxy's address rather than this host's. In production this is Cloudflare
# WARP behind a local privoxy bridge, because WARP speaks SOCKS5 and Bun's fetch
# does not. Empty disables it. Never point AllDebrid at this: its keys are bound
# to confirmed IPs and a new egress address is blocked until a human clicks a
# link in an email.
TORBOX_PROXY_URL=http://127.0.0.1:8118
# Cached sources to try, in order. TorBox first by default: its cache probe is
# free, while AllDebrid's only way to answer is to add the magnet.
CACHE_SOURCES=torbox,alldebrid
# The qBittorrent disk-cache fallback is off: an uncached release now fails the
# job as `uncached` rather than being leeched to local disk first.
QBIT_ENABLED=false
QBIT_URL=http://localhost:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=your_qbittorrent_password
# Last-resort source for the original .torrent when every cache mirror misses.
# Asks a swarm for the info dict via BEP 9 and takes nothing else — no payload
# is ever written. Off by default because it briefly puts this host in the
# swarm, visible to peers and trackers, unlike every other route here.
# Independent of QBIT_ENABLED, but it does need qBittorrent running.
QBIT_METADATA_FALLBACK=false
QBIT_METADATA_TIMEOUT_MS=180000
R2_BUCKET=dbrd
R2_PUBLIC_URL=https://upload.debridmediamanager.com
# DMM's internal metadata API (METADATA_API_SECRET on DMM): the first metadata
# source and the resolver for torrents added without an imdb id. The provider
# keys below are the fallback when DMM is unreachable.
DMM_METADATA_SECRET=
# DMM_METADATA_URL=https://debridmediamanager.com
# DMM's takedown blocklist, polled every 10 minutes; the last good copy is kept
# in data/takedown-blocklist.json. Empty disables the check (dev/tests only).
# DMM_BLOCKLIST_URL=https://debridmediamanager.com/api/takedown/blocklist
MDBLIST_KEY=your_mdblist_api_key
OMDB_API_KEY=your_omdb_api_key
TMDB_API_KEY=your_tmdb_api_key
